# -----------------------------------------------------------
# Project General Settings
# -----------------------------------------------------------
PROJECT_NAME=syntria
PYTHON_VERSION=3.12-slim

# -----------------------------------------------------------
# PostgreSQL Configuration
# -----------------------------------------------------------
POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_CONTAINER_NAME=postgres
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin
POSTGRES_DB=db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# -----------------------------------------------------------
# PgAdmin Configuration
# -----------------------------------------------------------
PGADMIN_IMAGE=dpage/pgadmin4:latest
PGADMIN_CONTAINER_NAME=pgadmin
PGADMIN_DEFAULT_EMAIL=admin@email.com
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050
PGADMIN_LISTEN_PORT=5050

# -----------------------------------------------------------
# FastAPI (Backend) Configuration
# -----------------------------------------------------------
FASTAPI_CONTAINER_NAME=fastapi
FASTAPI_PORT=8000
SECRET_KEY=supersecret_jwt_key_change_me_in_production

# -----------------------------------------------------------
# NiceGUI (Frontend) Configuration
# -----------------------------------------------------------
NICEGUI_CONTAINER_NAME=nicegui
NICEGUI_PORT=8080
API_BASE_URL=http://api:${FASTAPI_PORT}/api/v1

# -----------------------------------------------------------
# Nginx (Reverse Proxy) Configuration
# -----------------------------------------------------------
NGINX_IMAGE=nginx:alpine
NGINX_CONTAINER_NAME=nginx_proxy

# -----------------------------------------------------------
# Tailscale (VPN Gateway) Configuration
# -----------------------------------------------------------
TAILSCALE_IMAGE=tailscale/tailscale:latest
TAILSCALE_CONTAINER_NAME=tailscale_gateway
TAILSCALE_HOSTNAME=syntria
# Generate this from the Tailscale Admin Console (Settings -> Keys)
TS_AUTHKEY=tskey-auth-YOUR_KEY_HERE_CHANGE_ME